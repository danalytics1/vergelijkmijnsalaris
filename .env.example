# AWS Bedrock (EU) — Claude
LLM_PROVIDER=bedrock            # bedrock | mistral
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Mistral (EU) — alternatief
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Supabase (EU / Frankfurt)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC-sleutel voor het ondertekenen van uitgelezen waarden (min. 32 tekens random)
TOKEN_SECRET=

# Optioneel: Upstash Redis (EU) voor rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
