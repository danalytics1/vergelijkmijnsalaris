# LLM-provider: mistral (standaard, EU) | anthropic (Claude via Anthropic API, verwerking buiten de EU) | bedrock
# Na wisselen opnieuw deployen: de privacyteksten worden bij de build gerenderd.
LLM_PROVIDER=mistral

# Mistral (EU) — zet zero data retention aan in La Plateforme
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Anthropic API (Claude) — direct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# AWS Bedrock (EU) — Claude, alternatief
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Supabase (EU / Frankfurt)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC-sleutel voor het ondertekenen van uitgelezen waarden (min. 32 tekens random)
TOKEN_SECRET=

# Optioneel: Upstash Redis (EU) voor rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
